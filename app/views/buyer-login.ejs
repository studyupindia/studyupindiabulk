<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyUpIndia - <%= title %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/buyer-login.css">
</head>
<body>
    <div class="page-background">
        <div class="bg-overlay"></div>
    </div>

    <div class="auth-wrapper">
        <div class="auth-container">
            <div class="auth-header">
                <div class="logo">
                    <img src="https://studyupindia.com/wp-content/uploads/2022/09/4-scaled-e1661241090379-removebg-preview.png" alt="StudyUp Logo">
                </div>
                <h1>Buyer Login</h1>
                <p>Login to your account to purchase books</p>
            </div>
            
            <div class="auth-content">
                <div id="error-message" class="error-message hidden">
                    <i class="fas fa-exclamation-circle"></i>
                    <span>Invalid email or password. Please try again.</span>
                </div>
                
                <form id="buyer-login-form" class="auth-form">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="Enter your email address" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="password">Password</label>
                        <div class="password-input">
                            <input type="password" id="password" name="password" placeholder="Enter your password" required>
                            <button type="button" class="toggle-password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    
                    <div class="form-options">
                        <div class="remember-me">
                            <label class="checkbox">
                                <input type="checkbox" id="remember" name="remember">
                                <span class="checkbox-custom"></span>
                                <span class="checkbox-label">Remember me</span>
                            </label>
                        </div>
                        <a href="/buyer/forgot-reset-password" class="forgot-password">Forgot password?</a>
                    </div>
                    
                    <div class="form-action">
                        <button type="submit" id="login-button" class="btn-submit">
                            <span class="btn-text">Login</span>
                            <span class="btn-loader hidden">
                                <i class="fas fa-spinner fa-spin"></i>
                            </span>
                        </button>
                    </div>
                </form>
                
                <div class="separator">
                    <span>or</span>
                </div>
                
                <div class="auth-cta">
                    <p>Don't have an account?</p>
                    <a href="/buyer/signup" class="btn-cta">Create Account</a>
                </div>

                <div class="seller-link">
                    <p>Are you a book seller?</p>
                    <a href="/seller/signin">Login as Seller</a>
                </div>
                
                <div class="auth-footer">
                    <p>© 2025 StudyUp. All rights reserved.</p>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/buyer-login.js"></script>
</body>
</html>