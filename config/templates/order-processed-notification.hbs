<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Order #{{orderId}} is Being Processed</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            padding: 20px;
            max-width: 600px;
            margin: auto;
        }

        .header {
            background-color: #4caf50;
            color: #fff;
            padding: 15px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }

        .content {
            border: 1px solid #e0e0e0;
            padding: 20px;
            border-radius: 0 0 5px 5px;
            background: #f9f9f9;
        }

        .button {
            display: inline-block;
            padding: 10px 20px;
            background: #3f51b5;
            color: #fff !important;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 20px;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: #777;
            margin-top: 30px;
        }
    </style>
</head>

<body>
    <div class="header">
        <h2>Your Order is Being Processed</h2>
    </div>
    <div class="content">
        <p>Hi {{buyerName}},</p>

        <p>Your order <strong>#{{orderId}}</strong> is now being processed by {{sellerName}}.</p>

        <p><strong>Processing Notes:</strong></p>
        <blockquote>{{processingNotes}}</blockquote>

        <p><strong>Updated:</strong> {{processingDate}}</p>

        <a class="button" href="{{dashboardLink}}">Track Order in Dashboard</a>

        <p>Thanks for choosing {{companyName}}!</p>

        <div class="footer">
            <p>&copy; {{currentYear}} {{companyName}}. Need help? <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>
            </p>
        </div>
    </div>
</body>

</html>