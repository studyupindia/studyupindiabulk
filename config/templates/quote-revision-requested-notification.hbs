<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <title>Revision Requested - Order #{{orderNumber}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            background-color: #2196F3;
            color: white;
            padding: 15px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }

        .content {
            background-color: #f9f9f9;
            padding: 20px;
            border-radius: 0 0 5px 5px;
            border: 1px solid #e0e0e0;
        }

        .status-box {
            background-color: #e3f2fd;
            border-left: 4px solid #2196F3;
            padding: 10px 15px;
            margin: 15px 0;
        }

        .order-info {
            background-color: #fff;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
            border: 1px solid #e0e0e0;
        }

        .books-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }

        .books-table th,
        .books-table td {
            border: 1px solid #e0e0e0;
            padding: 8px;
            text-align: left;
        }

        .books-table th {
            background-color: #f2f2f2;
        }

        .totals {
            margin-top: 15px;
            text-align: right;
        }

        .button {
            display: inline-block;
            background-color: #4CAF50;
            color: white !important;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 15px;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: #777;
            margin-top: 20px;
        }
    </style>
</head>

<body>
    <div class="header">
        <h2>Quote Revision Requested</h2>
    </div>

    <div class="content">
        <p>Dear {{sellerName}},</p>

        <p>Your quote for Order #{{orderNumber}} has received a revision request from the buyer
            <strong>{{buyerName}}</strong>.</p>

        <div class="status-box">
            <strong>Revision Reason:</strong>
            <p>{{revisionReason}}</p>
        </div>

        <div class="order-info">
            <p><strong>Order Number:</strong> #{{orderNumber}}</p>
            <p><strong>Request Date:</strong> {{revisionDate}}</p>
            <p><strong>Status:</strong> <span style="color: #2196F3;">PENDING REVISION</span></p>
            <p><strong>Shipping Address:</strong><br>{{shippingAddress}}</p>
        </div>

        <h3>Books in Quote:</h3>
        <table class="books-table">
            <thead>
                <tr>
                    <th>Book</th>
                    <th>Quantity</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                {{#each books}}
                <tr>
                    <td>{{title}}</td>
                    <td>{{quantity}}</td>
                    <td>₹{{price}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <div class="totals">
            <p><strong>Subtotal:</strong> ₹{{subtotal}}</p>
            <p><strong>Discount ({{discountPercentage}}%):</strong> -₹{{discountAmount}}</p>
            <p><strong>Delivery Charges:</strong> ₹{{deliveryCharges}}</p>
            <p><strong>Handling Charges:</strong> ₹{{handlingCharges}}</p>
            <p><strong>Total:</strong> ₹{{finalTotal}}</p>
        </div>

        <a href="{{dashboardLink}}" class="button">Revise Quote Now</a>

        <p>Thank you for using our platform.</p>

        <p>Best regards,<br />The {{companyName}} Team</p>
    </div>

    <div class="footer">
        <p>© {{currentYear}} {{companyName}}. All rights reserved.</p>
        <p>Need help? Contact us at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a></p>
    </div>
</body>

</html>