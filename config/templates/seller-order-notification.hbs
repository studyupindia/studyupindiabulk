<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>New Order Request - {{orderNumber}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333333;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            background-color: #4a6fdc;
            color: white;
            padding: 15px;
            text-align: center;
            border-radius: 5px 5px 0 0;
        }

        .content {
            background-color: #f9f9f9;
            padding: 20px;
            border-radius: 0 0 5px 5px;
            border: 1px solid #e0e0e0;
        }

        .order-info {
            background-color: #ffffff;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
            border: 1px solid #e0e0e0;
        }

        .books-table {
            width: 100%;
            border-collapse: collapse;
            margin: 15px 0;
        }

        .books-table th,
        .books-table td {
            border: 1px solid #e0e0e0;
            padding: 8px;
            text-align: left;
        }

        .books-table th {
            background-color: #f2f2f2;
        }

        .footer {
            text-align: center;
            font-size: 12px;
            color: #777777;
            margin-top: 20px;
        }

        .button {
            display: inline-block;
            background-color: #4a6fdc;
            color: white !important;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 5px;
            margin-top: 15px;
        }

        .totals {
            margin-top: 15px;
            text-align: right;
        }

        a{
            color: #f2f2f2 !important;
            text-decoration: none;
        }
    </style>
</head>

<body>
    <div class="header">
        <h2>New Order Request</h2>
    </div>

    <div class="content">
        <p>Hello {{sellerName}},</p>

        <p>You have received a new order request from <strong>{{buyerName}}</strong>.</p>

        <div class="order-info">
            <p><strong>Order #:</strong> {{orderNumber}}</p>
            <p><strong>Date:</strong> {{orderDate}}</p>
            <p><strong>Status:</strong> <span style="color: #ff9900;">{{orderStatus}}</span></p>

            {{#if buyerMessage}}
            <p><strong>Message from buyer:</strong> "{{buyerMessage}}"</p>
            {{/if}}

            <p><strong>Shipping Address:</strong><br>
                {{shippingAddress}}</p>
        </div>

        <h3>Order Details:</h3>
        <table class="books-table">
            <thead>
                <tr>
                    <th>Book Code</th>
                    <th>Title</th>
                    <th>Class</th>
                    <th>Subject</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                {{#each books}}
                <tr>
                    <td>{{this.code}}</td>
                    <td>{{this.title}}</td>
                    <td>{{this.class}}</td>
                    <td>{{this.subject}}</td>
                    <td>₹{{this.price}}</td>
                    <td>{{this.quantity}}</td>
                    <td>₹{{this.total}}</td>
                </tr>
                {{/each}}
            </tbody>
        </table>

        <div class="totals">
            <p><strong>Subtotal:</strong> ₹{{subtotal}}</p>
            <p><strong>Delivery Charges:</strong> ₹{{deliveryCharges}}</p>
            <p><strong>Handling Charges:</strong> ₹{{handlingCharges}}</p>
            <p><strong>Total:</strong> ₹{{totalPrice}}</p>
        </div>

        <p>Please log in to your seller dashboard to review this order and provide a quote.</p>

        <a href="{{dashboardLink}}" class="button">View Order Details</a>

        <p>Thank you for your prompt attention to this order.</p>

        <p>Best regards,<br>
            The {{companyName}} Team</p>
    </div>

    <div class="footer">
        <p>© {{currentYear}} {{companyName}}. All rights reserved.</p>
        <p>This email was sent to you because you are a registered seller on our platform.</p>
    </div>
</body>

</html>